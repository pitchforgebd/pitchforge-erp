{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(npm install *)",
      "Bash(npx *)",
      "Bash(pnpm dlx *)",
      "Bash(docker *)",
      "Bash(terraform *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm -rf *)"
    ],
    "allow": [
      "Bash(pnpm lint *)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm format)",
      "Bash(pnpm check:boundaries)",
      "Bash(pnpm contracts:openapi)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
